# Löst beim Einstecken eines Realtek-Bluetooth-Sticks, den der Kernel 5.10 nicht kennt, den Treiberbau aus (pipbox-btdriver.service).
# Der Dienst prüft selbst, ob etwas zu tun ist (Kernel, Werkzeuge, keine Übertragung). Rückweg: Datei löschen.

# Realtek RTL8761B (0bda:8771)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0bda", ATTR{idProduct}=="8771", TAG+="systemd", ENV{SYSTEMD_WANTS}+="pipbox-btdriver.service"
# Realtek (0bda:a725)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0bda", ATTR{idProduct}=="a725", TAG+="systemd", ENV{SYSTEMD_WANTS}+="pipbox-btdriver.service"
# TP-Link UB500 (Realtek RTL8761BUV)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2357", ATTR{idProduct}=="0604", TAG+="systemd", ENV{SYSTEMD_WANTS}+="pipbox-btdriver.service"
# Realtek RTL8761B (2550:8761)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2550", ATTR{idProduct}=="8761", TAG+="systemd", ENV{SYSTEMD_WANTS}+="pipbox-btdriver.service"
# Realtek RTL8761B (2b89:8761)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2b89", ATTR{idProduct}=="8761", TAG+="systemd", ENV{SYSTEMD_WANTS}+="pipbox-btdriver.service"
# Mercusys MA530 (Realtek RTL8761B)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2c4e", ATTR{idProduct}=="0115", TAG+="systemd", ENV{SYSTEMD_WANTS}+="pipbox-btdriver.service"
